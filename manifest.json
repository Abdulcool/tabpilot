{
  "manifest_version": 3,
  "name": "TabPilot",
  "short_name": "TabPilot",
  "version": "1.0.0",
  "description": "Search, dedupe, group and save your tabs, all from the keyboard.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "TabPilot (Alt+T)",
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "permissions": ["tabs", "tabGroups", "storage"],
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+T", "mac": "Alt+T" },
      "description": "Open TabPilot"
    },
    "close-duplicates": {
      "suggested_key": { "default": "Alt+Shift+D", "mac": "Alt+Shift+D" },
      "description": "Close duplicate tabs"
    },
    "group-by-site": {
      "suggested_key": { "default": "Alt+Shift+G", "mac": "Alt+Shift+G" },
      "description": "Group tabs by site"
    }
  }
}
